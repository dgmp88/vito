# Gemini API key. Used server-side only:
#   - to mint single-use ephemeral tokens for the Live voice session (gemini-3.8-live)
#   - to run expert handoffs (gemini-4-neon)
# The browser never sees this key.
GEMINI_API_KEY=...

# Optional overrides (defaults shown).
# VITO_LIVE_MODEL=gemini-3.8-live
# VITO_EXPERT_MODEL=gemini-4-neon
# VITO_EXPERT_THINKING=medium   # minimal | low | medium | high | xhigh

# Neon Auth (email + password). Copy the Auth URL from the Neon Console
# (your project → Auth). VITE_-prefixed because the browser talks to it directly;
# it's a public endpoint, not a secret. The server uses it to verify session JWTs.
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth

# Neon Postgres connection string (server-side only). Conversations, messages,
# and usage live here. Apply the schema with `npm run db:migrate`.
DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.build/neondb?sslmode=require
